{
  "name": "apiark",
  "private": true,
  "version": "0.2.28",
  "description": "Local-first API development platform",
  "scripts": {
    "dev": "bun --filter @apiark/desktop dev",
    "build": "bun --filter @apiark/desktop build",
    "tauri": "bun --filter @apiark/desktop tauri",
    "lint": "bun --filter @apiark/desktop lint",
    "typecheck": "bun --filter @apiark/desktop typecheck",
    "test": "bun --filter @apiark/desktop test",
    "preview": "bun --filter @apiark/desktop preview"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.2.4",
  "engines": {
    "bun": ">=1.1.0"
  }
}
